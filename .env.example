# Shared mainnet configuration
PROGRAM_ID=8hDEL5BuW2BgeMuCBKqZyRubGTqFmx8Ds3PQ2k6puJym
SOLANA_RPC_HTTP=https://your-private-mainnet-rpc.example

# Oracle publisher (store the key as a Railway secret; never commit it)
ORACLE_KEYPAIR_JSON=[64-byte-secret-array]
ORACLE_INTERVAL_MS=15000
ORACLE_SOURCE_MAX_AGE_SECONDS=30
ORACLE_REFRESH_LEAD_SECONDS=20
ORACLE_MAX_SOURCE_DEVIATION_BPS=500
ORACLE_MINIMUM_LIQUIDITY_USD=10000
ORACLE_LIQUIDITY_HAIRCUT_BPS=200
ORACLE_MAX_RECOVERABLE_USDC=25000
ORACLE_MINIMUM_BALANCE_LAMPORTS=20000000
JUPITER_API_KEY=
JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
ORACLE_ENABLE_SINGLE_VENUE_MODE=false
ORACLE_SINGLE_VENUE_MAX_LLTV_BPS=5000
ORACLE_SINGLE_VENUE_PRICE_HAIRCUT_BPS=1000
ORACLE_SINGLE_VENUE_LIQUIDITY_HAIRCUT_BPS=100
ORACLE_SINGLE_VENUE_MAX_RECOVERABLE_USDC=500
ORACLE_MAX_JUPITER_PRICE_IMPACT_BPS=500
PYTH_API_KEY=
# Leave this as {} for collateral without an official Pyth feed. Keys are collateral mint
# addresses; values are 32-byte Pyth feed IDs encoded as 64 hexadecimal characters.
PYTH_FEED_MAP_JSON={}
ALERT_WEBHOOK_URL=
ORACLE_REFRESH_SECRET=replace-with-at-least-32-random-characters

# Set only on the separately deployed backup publisher service.
ORACLE_STANDBY=false
ORACLE_FAILOVER_AFTER_SECONDS=45
